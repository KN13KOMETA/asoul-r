{
  "name": "asoul-r",
  "version": "2.0.0-beta",
  "description": "",
  "main": "build/index.js",
  "scripts": {
    "dev": "pnpm build:paraglide && concurrently -k -n bot,paraglide -c blue,green \"nodemon\" \"nodemon --config paraglide.nodemon.json\"",
    "clean": "rimraf build && rimraf src/paraglide",
    "build:paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "build:typescript": "tsc",
    "build": "pnpm clean && pnpm build:paraglide && pnpm build:typescript",
    "start": "node --env-file=.env build/index.ts",
    "typecheck:src": "resultar-check",
    "typecheck:test": "resultar-check -p tests/tsconfig.json",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:test",
    "lint:reuse": "reuse lint",
    "lint:biome": "biome check --error-on-warnings .",
    "lint:biome-fix": "biome check --write .",
    "lint": "pnpm lint:reuse && pnpm lint:biome",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "inlang check --project ./project.inlang",
    "check": "pnpm lint && pnpm check:i18n && pnpm typecheck && pnpm test"
  },
  "keywords": [],
  "author": "KN13KOMETA <kn13kometa@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@inlang/cli": "^3.4.0",
    "@inlang/paraglide-js": "^3.1.0",
    "@oxc-node/cli": "^1.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "resultar-check": "^4.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "resultar": "^4.0.1",
    "zod": "^4.6.7"
  }
}
