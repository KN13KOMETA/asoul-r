{
  "name": "asoul-r",
  "version": "2.0.0-beta",
  "description": "",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts | pino-pretty",
    "clean": "rimraf build",
    "build": "pnpm clean && tsc",
    "start": "node --env-file=.env build/index.ts",
    "typecheck:src": "resultar-check",
    "typecheck:test": "resultar-check -p tests/tsconfig.json",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:test",
    "lint:reuse": "reuse lint",
    "lint:biome": "biome check .",
    "lint:biome-fix": "biome check --write .",
    "lint": "pnpm lint:reuse && pnpm lint:biome",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "keywords": [],
  "author": "KN13KOMETA <kn13kometa@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "resultar-check": "^4.0.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "pino": "^10.4.0",
    "resultar": "^4.0.1",
    "zod": "^4.6.7"
  }
}
