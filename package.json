{
  "name": "asoul-r",
  "version": "1.0.0",
  "description": "Discord utility bot written in TS with discord.js",
  "main": "build/src/index.js",
  "scripts": {
    "clean": "rimraf build",
    "build": "pnpm clean && tsc",
    "start": "node build/src/index.js",
    "watch": "tsc -w",
    "dev": "tsx watch src/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot"
  ],
  "author": "KN13KOMETA",
  "license": "SEE IN LICENSE",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/levenshtein": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "levenshtein": "^1.0.5",
    "qrcode": "^1.5.4",
    "weather-js": "^2.0.0"
  }
}
