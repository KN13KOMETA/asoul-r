{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "plugins": [
    "node_modules/@gracefullight/biome-plugin/rules/no-relative-imports.grit"
  ],
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!src/paraglide",
      "!!dist",
      "!!project.inlang/**/*",
      "project.inlang/settings.json",
      "project.inlang/descriptions.json",
      "project.inlang/paraglide.config.{js,mjs,ts,cjs}"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
